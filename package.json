{
  "name": "prince-b-wcm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "seed:faqs": "node --env-file-if-exists=.env src/db/seed-faqs.js",
    "admin:create": "node --env-file-if-exists=.env src/db/create-admin.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0"
  }
}
